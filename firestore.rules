rules_version = '2';

// Connectify Firestore Security Rules
// Deploy via: firebase deploy --only firestore:rules
//
// Threat model:
//   - Users must be authenticated to read/write anything
//   - Users can ONLY access their own document (no cross-user reads)
//   - All fields are type-checked and size-limited
//   - Points are clamped to sane ranges to prevent client-side manipulation
//   - Array fields (IDs) are capped to prevent storage abuse
//   - No wildcard collection access — only explicitly defined paths
//
// PRODUCTION LOCKDOWN — ACTIVE:
//   pointsBalance / lifetimePoints / checkedInEventIDs / redeemedRewardIDs are
//   SERVER-OWNED. Clients cannot change them on update (diff check below) and must
//   create documents with them absent or zero/empty. Only the Cloud Functions
//   callables (checkInToEvent / collectPlace / redeemReward — Admin SDK, which
//   bypasses these rules) can write them. collectedPlaceIDs stays client-writable
//   for offline merge, but direct writes to it award NO points.

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // DEFAULT: deny everything not explicitly allowed
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────
    // SERVER-ONLY COLLECTIONS — never client-accessible
    // ──────────────────────────────────────────────
    // These hold the most sensitive data in the system and are written purely
    // by Cloud Functions via the Admin SDK (which bypasses these rules):
    //   /attendance   — GPS coordinates + proof-photo paths per check-in
    //   /fulfillments — gift-card orders incl. delivery email + points spent
    // The catch-all above already denies them; stating it explicitly means a
    // future edit can't widen access to them by accident.
    match /attendance/{docId} {
      allow read, write: if false;
    }
    match /fulfillments/{docId} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────
    // USER DOCUMENTS: /users/{userId}
    // ──────────────────────────────────────────────
    match /users/{userId} {

      // Only the authenticated owner can read their own document
      allow read: if isOwner(userId);

      // Only the authenticated owner can create their document.
      // Server-owned fields must start absent or zero/empty — the Functions award them.
      allow create: if isOwner(userId)
                    && validUserDocument(request.resource.data)
                    && serverOwnedFieldsAtZero(request.resource.data);

      // Only the authenticated owner can update their document — and never the
      // server-owned game fields (points / check-ins / redemptions).
      allow update: if isOwner(userId)
                    && validUserDocument(request.resource.data)
                    && noForbiddenFieldChanges()
                    && noServerOwnedFieldChanges();

      // Users cannot delete their own document (admin-only operation)
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // COMMUNITY EVENTS: /events/{eventId}
    // ──────────────────────────────────────────────
    match /events/{eventId} {

      // Any authenticated user can read events
      allow read: if request.auth != null;

      // Any authenticated user can create an event (must include their UID as creatorID)
      allow create: if request.auth != null
                    && request.resource.data.creatorID == request.auth.uid
                    && validEventDocument(request.resource.data);

      // Only the creator can update their event
      allow update: if request.auth != null
                    && resource.data.creatorID == request.auth.uid
                    && request.resource.data.creatorID == request.auth.uid
                    && validEventDocument(request.resource.data);

      // Only the creator can delete their event
      allow delete: if request.auth != null
                    && resource.data.creatorID == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // COMMUNITY POSTS: /posts/{postId}
    // ──────────────────────────────────────────────
    match /posts/{postId} {
      // Any authenticated user can read the feed.
      allow read: if request.auth != null;

      // Authors can create their own posts (must stamp their UID).
      allow create: if request.auth != null
                    && request.resource.data.authorID == request.auth.uid
                    && validPostDocument(request.resource.data);

      // Posts are immutable EXCEPT likes: any signed-in user may bump likeCount
      // by exactly +1 per write (nothing else may change). Author can delete.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
                    && request.resource.data.likeCount == resource.data.likeCount + 1;
      allow delete: if request.auth != null
                    && resource.data.authorID == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────

    // Validate a community post.
    function validPostDocument(data) {
      let validContent = data.content is string && data.content.size() >= 1 && data.content.size() <= 1000;
      let validAuthor = data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100;
      let validPlace = !('placeName' in data) || (data.placeName is string && data.placeName.size() <= 200);
      let allowed = ['authorID', 'authorName', 'authorInitials', 'placeName', 'content', 'createdAt', 'likeCount'];
      return validContent && validAuthor && validPlace && data.keys().hasOnly(allowed);
    }


    // Verify the request comes from the document owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Validate the full user document schema and value ranges
    function validUserDocument(data) {
      return validProfileFields(data) && validGameStateFields(data);
    }

    // Validate profile fields, timestamps, and field allowlist
    function validProfileFields(data) {
      let validDisplayName = !('displayName' in data) ||
        (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100);

      let validEmail = !('email' in data) ||
        (data.email is string && data.email.size() >= 5 && data.email.size() <= 320);

      let validInterests = !('interests' in data) ||
        (data.interests is list && data.interests.size() <= 20);

      let validLastUpdated = !('lastUpdated' in data) ||
        (data.lastUpdated is timestamp);

      let validCreatedAt = !('createdAt' in data) ||
        (data.createdAt is timestamp);

      let allowedFields = [
        'displayName', 'email', 'interests',
        'collectedPlaceIDs', 'checkedInEventIDs', 'redeemedRewardIDs',
        'pointsBalance', 'lifetimePoints',
        'lastUpdated', 'createdAt'
      ];
      let noExtraFields = data.keys().hasOnly(allowedFields);

      return validDisplayName && validEmail && validInterests
          && validLastUpdated && validCreatedAt && noExtraFields;
    }

    // Validate game state fields (collections, points)
    function validGameStateFields(data) {
      let validCollectedPlaces = !('collectedPlaceIDs' in data) ||
        (data.collectedPlaceIDs is list && data.collectedPlaceIDs.size() <= 500);

      let validCheckedInEvents = !('checkedInEventIDs' in data) ||
        (data.checkedInEventIDs is list && data.checkedInEventIDs.size() <= 500);

      let validRedeemedRewards = !('redeemedRewardIDs' in data) ||
        (data.redeemedRewardIDs is list && data.redeemedRewardIDs.size() <= 200);

      let validPointsBalance = !('pointsBalance' in data) ||
        (data.pointsBalance is int && data.pointsBalance >= 0 && data.pointsBalance <= 1000000);

      let validLifetimePoints = !('lifetimePoints' in data) ||
        (data.lifetimePoints is int && data.lifetimePoints >= 0 && data.lifetimePoints <= 10000000);

      return validCollectedPlaces && validCheckedInEvents && validRedeemedRewards
          && validPointsBalance && validLifetimePoints;
    }

    // Validate event document schema (split into two helpers — the rules
    // compiler allows at most 10 let-bindings per function).
    function validEventDocument(data) {
      return validEventCoreFields(data) && validEventMetaFields(data);
    }

    function validEventCoreFields(data) {
      let validTitle = data.title is string && data.title.size() >= 1 && data.title.size() <= 200;
      let validDescription = !('description' in data) ||
        (data.description is string && data.description.size() <= 2000);
      let validOrganizer = data.organizer is string && data.organizer.size() >= 1 && data.organizer.size() <= 200;
      let validDate = data.date is timestamp;
      let validTime = data.time is string && data.time.size() >= 1 && data.time.size() <= 50;
      let validLocation = data.locationName is string && data.locationName.size() >= 1 && data.locationName.size() <= 300;

      return validTitle && validDescription && validOrganizer && validDate
          && validTime && validLocation;
    }

    function validEventMetaFields(data) {
      let validAttendees = data.attendeeCount is int && data.attendeeCount >= 0 && data.attendeeCount <= 100000;
      let validMaxAttendees = !('maxAttendees' in data) || data.maxAttendees == null ||
        (data.maxAttendees is int && data.maxAttendees >= 1 && data.maxAttendees <= 100000);
      let validCategory = data.category is string && data.category.size() <= 50;
      let validPoints = data.pointValue is int && data.pointValue >= 0 && data.pointValue <= 1000;
      let validCreator = data.creatorID is string && data.creatorID.size() >= 1;

      // Optional venue coordinates — used by checkInToEvent's proximity check.
      let validLatitude = !('latitude' in data) ||
        (data.latitude is number && data.latitude >= -90 && data.latitude <= 90);
      let validLongitude = !('longitude' in data) ||
        (data.longitude is number && data.longitude >= -180 && data.longitude <= 180);

      let allowedFields = [
        'title', 'description', 'organizer', 'date', 'time',
        'locationName', 'attendeeCount', 'maxAttendees',
        'category', 'imagePlaceholder', 'pointValue',
        'creatorID', 'createdAt', 'latitude', 'longitude'
      ];
      let noExtraFields = data.keys().hasOnly(allowedFields);

      return validAttendees && validMaxAttendees && validCategory
          && validPoints && validCreator && validLatitude && validLongitude
          && noExtraFields;
    }

    // SERVER-OWNED game fields: only Cloud Functions (Admin SDK) may change these.
    // `plusExpiresAt` is the Verdure+ entitlement — written solely by verified
    // App Store server notifications. A client that could set it would grant
    // itself the earn multiplier and early reward access, so it is locked here.
    function noServerOwnedFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['pointsBalance', 'lifetimePoints', 'checkedInEventIDs',
                   'redeemedRewardIDs', 'plusExpiresAt']);
    }

    // On create, server-owned fields must be absent or zero/empty — a fresh client
    // can't mint itself points or attendance history.
    function serverOwnedFieldsAtZero(data) {
      return (!('pointsBalance' in data) || data.pointsBalance == 0)
          && (!('lifetimePoints' in data) || data.lifetimePoints == 0)
          && (!('checkedInEventIDs' in data) || (data.checkedInEventIDs is list && data.checkedInEventIDs.size() == 0))
          && (!('redeemedRewardIDs' in data) || (data.redeemedRewardIDs is list && data.redeemedRewardIDs.size() == 0))
          // A fresh client may never mint itself a Verdure+ entitlement.
          && !('plusExpiresAt' in data);
    }

    // Prevent changing fields that should be immutable after creation
    function noForbiddenFieldChanges() {
      // email and createdAt cannot be changed after document creation
      let emailUnchanged = !('email' in request.resource.data) ||
        !('email' in resource.data) ||
        request.resource.data.email == resource.data.email;

      let createdAtUnchanged = !('createdAt' in request.resource.data) ||
        !('createdAt' in resource.data) ||
        request.resource.data.createdAt == resource.data.createdAt;

      return emailUnchanged && createdAtUnchanged;
    }
  }
}
