// Secrets.xcconfig.template — Copy to Secrets.xcconfig and fill in your values
// Get SerpApi key from https://serpapi.com
// Get Firebase values from your GoogleService-Info.plist (Firebase Console)

SERPAPI_KEY = your_serpapi_key_here
FIREBASE_API_KEY = your_firebase_api_key_here
FIREBASE_GCM_SENDER_ID = your_gcm_sender_id_here
FIREBASE_PROJECT_ID = your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET = your_firebase_storage_bucket_here
FIREBASE_GOOGLE_APP_ID = your_firebase_google_app_id_here
